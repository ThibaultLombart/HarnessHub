# Copy these values into the systemd EnvironmentFile. Never commit the real file.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_GUILD_ID=123456789012345678
DISCORD_ADMIN_USER_ID=123456789012345678
HARNESSHUB_WORKSPACE_ROOT=/srv/harnesshub/workspaces
HARNESSHUB_DATABASE_PATH=/var/lib/harnesshub/harnesshub.sqlite
HARNESSHUB_PI_COMMAND=pi
PI_CODING_AGENT_DIR=/var/lib/harnesshub/pi-agent
HARNESSHUB_MAX_CONCURRENT_SESSIONS=2
LOG_LEVEL=info
