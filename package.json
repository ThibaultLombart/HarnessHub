{
  "name": "harnesshub",
  "version": "0.1.0",
  "description": "Self-hosted Discord control plane for coding harnesses",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.5 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{json,js,ts}\" \"docs/INSTALLATION.md\" \"docs/PROXMOX_VM_GUIDE.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{json,js,ts}\" \"docs/INSTALLATION.md\" \"docs/PROXMOX_VM_GUIDE.md\"",
    "lint": "eslint . --max-warnings 0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThibaultLombart/HarnessHub.git"
  },
  "license": "MIT",
  "dependencies": {
    "discord.js": "14.27.0",
    "pino": "10.3.1",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
